{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/admin/blog(.*)",
      "dest": "/admin/blog"
    },
    {
      "src": "/admin(.*)",
      "dest": "/admin"
    },
    {
      "src": "/blog(.*)",
      "dest": "/blog"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}